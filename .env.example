# Lokal SQLite fayl. Keyinchalik PostgreSQL ga o'tishda faqat shu qiymat va
# prisma/schema.prisma dagi provider o'zgaradi.
DATABASE_URL="file:./data/finova.db"

# Birinchi foydalanuvchidan keyin ro'yxatdan o'tish yopiladi.
# Qo'shimcha foydalanuvchi qo'shish uchun "true" qiling.
ALLOW_REGISTRATION="false"
